# 统一换行符：仓库内一律存 LF，避免 Windows / Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.bin binary
*.safetensors binary

# 锁文件在 diff / 语言统计里折叠
uv.lock linguist-generated=true
package-lock.json linguist-generated=true

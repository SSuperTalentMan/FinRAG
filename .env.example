# FinRag 环境变量配置示例
# 复制为 .env 并填入真实值：cp .env.example .env
# 这些变量会覆盖 config.ini 中的同名配置，便于不同部署环境切换。

# ─── LLM API（阿里云百炼 DashScope）──────────────────────────────────
# ⚠️ 不要把真实 Key 写进 config.ini 或提交到仓库
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：覆盖 config.ini 中的 model
LLM_MODEL=qwen3.7-flash
# 备用模型：主模型失败时自动降级重试一次（可选，留空不启用）
# LLM_FALLBACK_MODEL=qwen-turbo

# ─── MySQL ──────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=finrag_qa

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# ─── Milvus ─────────────────────────────────────────────────────────
# 本地 standalone 默认无鉴权，MILVUS_TOKEN 留空即可
MILVUS_URI=http://localhost:19530
MILVUS_DATABASE=finrag
MILVUS_COLLECTION=finrag_faq
# MILVUS_TOKEN=root:

# ─── 应用 ───────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# 允许跨域的前端来源（逗号分隔）；生产环境务必显式配置，不要使用 *
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
# 文件日志格式：留空为人类可读文本，设为 json 时输出结构化 JSON（便于 ELK / Loki 采集）
LOG_FORMAT=

# ─── 限流 / 配额（可选，覆盖 config.ini）────────────────────────────
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_LLM_QUOTA_WINDOW=3600
RATE_LIMIT_LLM_QUOTA_MAX=100

# ─── 检索策略（可选）────────────────────────────────────────
# 多策略检索（直接/HyDE/子查询/回溯，规则预筛路由）；false 时全部走直接检索
RETRIEVAL_MULTI_STRATEGY=true
# 规则未命中时对长查询启用 LLM 策略选择器兜底（增加延迟，默认关闭）
RETRIEVAL_STRATEGY_LLM_FALLBACK=false

# ─── Milvus schema 保护（可选）──────────────────────────────
# schema 不匹配时自动 drop 重建（会清空全部向量数据！仅限开发环境）
# MILVUS_AUTO_RECREATE=1

# ─── Prometheus 多进程聚合（多 worker 部署时启用）──────────
# 指向共享目录后 /metrics 自动切换为多进程聚合采集
# PROMETHEUS_MULTIPROC_DIR=/app/logs/prom

# ─── 仅 docker compose --profile infra 用到 ─────────────────────────
MYSQL_ROOT_PASSWORD=rootpass

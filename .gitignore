# ─── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ─── 虚拟环境 / 依赖缓存 ──────────────────────────────────────────────
uv.lock.bak

# ─── 密钥与本地配置（绝不入库）────────────────────────────────────────
.jwt_secret
.env
# 本地配置含数据库密码，请用 config.ini.example 作模板
# ⚠️ gitignore 不支持「行内注释」——# 只有独占一行才算注释。
#    之前写成 `config.ini   # 说明` 导致整行被当成一个永不匹配的文件名，
#    config.ini 实际处于「会被提交」状态，差点把 DB 凭据推进仓库。
config.ini
*.local.ini

# ─── 日志 ─────────────────────────────────────────────────────────────
logs/
*.log

